# ==============================================
# HealthTriage AI - Python ML Service Environment
# ==============================================
# Copy this file to .env and configure your settings

# ======================
# API Configuration
# ======================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ======================
# CORS Origins
# ======================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# ======================
# Model Configuration
# ======================
# Path to save/load trained models
MODEL_PATH=./model/trained_model.joblib

# Rule-based vs ML weight (0.0 to 1.0)
# Higher = more weight on rule-based logic
RULE_WEIGHT=0.6

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
