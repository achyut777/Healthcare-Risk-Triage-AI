{
    "name": "healthcare-risk-triage-ai",
    "version": "2.0.0",
    "description": "AI-powered healthcare risk triage system - Clinical Decision Support System (CDSS)",
    "type": "module",
    "author": "HealthTriage AI Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/Healthcare-Risk-Triage-AI"
    },
    "keywords": [
        "healthcare",
        "ai",
        "triage",
        "mern",
        "risk-assessment",
        "clinical-decision-support",
        "patient-prioritization",
        "mongodb",
        "react",
        "nodejs",
        "fastapi",
        "machine-learning"
    ],
    "scripts": {
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "server": "cd server && npm run dev",
        "client": "cd client && npm run dev",
        "install:all": "npm install && cd server && npm install && cd ../client && npm install",
        "build": "cd client && npm run build",
        "start": "cd server && npm start",
        "test": "cd server && npm test",
        "test:python": "cd backend && python -m pytest ../tests -v",
        "ml:start": "cd backend && python -m uvicorn app:app --reload --host 127.0.0.1 --port 8000",
        "lint": "cd client && npm run lint",
        "seed": "cd server && npm run seed"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
