# ==============================================
# HealthTriage AI - Server Environment Variables
# ==============================================
# Copy this file to .env and configure your settings

# ======================
# Server Configuration
# ======================
PORT=5000
NODE_ENV=development

# ======================
# MongoDB Connection
# ======================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/healthtriage

# MongoDB Atlas (example)
# MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/healthtriage

# ======================
# JWT Authentication
# ======================
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRE=7d

# ======================
# CORS Settings
# ======================
CLIENT_URL=http://localhost:3000

# ======================
# OpenAI API (Healthcare Chatbot)
# ======================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ======================
# Python ML Service
# ======================
ML_SERVICE_URL=http://localhost:8000

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

